# Slack App credentials
# Get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Your Slack user ID (for DMs)
# Find it: click your profile in Slack > ... > Copy member ID
MY_USER_ID=U0123456789

# Morning planning time (24hr format, your local timezone)
MORNING_TIME=11:30
TIMEZONE=Asia/Karachi

# Chrome Extension API
# Generate a random token: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=your-secret-api-token
API_PORT=8080

# Supabase Postgres (production data store).
# REQUIRED to manage your real tasks locally — without these, bot.py falls back
# to an empty local SQLite (focus.db) and won't see your live to-dos.
# Use the SAME values you set as GitHub Actions secrets (from Supabase → Connect →
# Session Pooler). Leave blank/unset only if you want a throwaway local SQLite.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
